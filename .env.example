# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/infraestructura_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-in-production"

# Email (opcional - para notificaciones)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@infraestructura.local"

# File Storage (opcional - para documentos)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# App Config
NEXT_PUBLIC_APP_NAME="Gestión Infraestructura"
NEXT_PUBLIC_APP_URL="http://localhost:3000"